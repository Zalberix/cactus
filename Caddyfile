{
    auto_https off
}

http://localhost {
    handle /ws/* {
        reverse_proxy 127.0.0.1:3009
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:3009 {
            transport http {
                dial_timeout 15s
                response_header_timeout 30s
            }
            lb_try_duration 5s
            lb_try_interval 250ms
            fail_duration 30s
        }
    }
    reverse_proxy http://127.0.0.1:3000 {
        transport http {
            dial_timeout 15s
            response_header_timeout 30s
        }
        lb_try_duration 5s
        lb_try_interval 250ms
        fail_duration 30s
    }
}
